# Copy to .env for local dev. NEVER commit real values. Set production secrets via the host (HF Space secrets / Render env).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
APP_URL=
ALLOWED_ORIGINS=
RATE_LIMIT=
RETRIEVAL_THRESHOLD=
LLM_TIMEOUT_S=
CACHE_TTL_S=
MAINTENANCE_MODE=
FF_FIND_MY_HOME=
FF_MAP=
FF_VOICE=
FF_HANDOFF_BRIEF=
FF_WIDGET_DEMO=
DATA_PATH=
STATIC_DIR=
# live | mock | off ; with no OPENROUTER_API_KEY the app answers via the extractive code path
LLM_MODE=
# Outbound LLM requests per UTC day (the free account allows 50 in total); at the cap no call is made
LLM_DAILY_BUDGET=45
# true = one extra LLM call per ambiguous message to pick a tool; default false (the code planner routes)
LLM_TOOL_ROUTING=false
# 402 / daily free cap -> no LLM calls for this many seconds (or until X-RateLimit-Reset)
LLM_QUOTA_COOLDOWN_S=
# GET /models at boot (free, no completion) to drop models that are gone / no longer free
LLM_BOOT_MODEL_CHECK=
# Baked answers written by backend/scripts/warm_cache.py (read-only at runtime)
ANSWER_CACHE_PATH=
INDEX_DIR=
EMBED_THREADS=
# Proxies in front of the app that append X-Forwarded-For (1 on HF Spaces / Render); check GET /readyz xff_hops_seen
TRUSTED_PROXY_HOPS=
# Footer links, read at runtime via /api/meta. Each link is hidden if unset.
CANDIDATE_NAME=
CANDIDATE_GITHUB=
CANDIDATE_LINKEDIN=
CANDIDATE_EMAIL=
